{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "paralyx-solana.vercel.app"
        }
      ],
      "destination": "https://paralyx.wienerlabs.xyz/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/rail.ts": {
      "maxDuration": 120
    }
  }
}
